namespace CedarGatekeeper {

entity GitHubUser;

entity PullRequest;

action approvePR appliesTo {
  principal: [GitHubUser],
  resource: [PullRequest],
  context: {
    changedPath: String,
    totalLinesChanged: Long,
    prAuthor: GitHubUser,
    activeTeams: Set<String>,
    dayOfWeek: String,
    isHotfix: Bool
  }
};

action mergePR appliesTo {
  principal: [GitHubUser],
  resource: [PullRequest],
  context: {
    changedPath: String,
    totalLinesChanged: Long,
    prAuthor: GitHubUser,
    activeTeams: Set<String>,
    dayOfWeek: String,
    isHotfix: Bool
  }
};

}
